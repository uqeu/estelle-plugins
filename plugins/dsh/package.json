{
  "name": "dsh-plugin-estelle",
  "version": "0.0.16",
  "description": "Estelle MCP, memory and session hooks for coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uqeu/estelle-plugins.git",
    "directory": "plugins/dsh"
  },
  "main": "adapters/dsh-plugin.mjs",
  "exports": {
    ".": "./adapters/dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
