{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "estelle": {
      "type": "streamable-http",
      "url": "https://api.fatelabs.ca/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["estelle:mcp", "offline_access"]
          }
        }
      }
    }
  }
}
